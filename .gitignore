# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python & NetPulse Backend
__pycache__/
*.py[cod]
*$py.class
.venv/
backend/.venv/
.pytest_cache/
*.db
*.db-wal
*.db-shm
backend/captures/*.pcap
backend/captures/*.pcapng
!backend/captures/demo_lan_traffic.pcap
backend/reports/*.pdf
backend/reports/*.csv
backend/reports/*.json
